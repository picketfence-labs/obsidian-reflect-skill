# obsidian-reflect-skillのgeneric設定例。
# Vaultでcommit pinする場合は、対象Vaultの
# `.agents/skill-config/obsidian-reflect.yaml`へコピーして調整する。
# 従来どおりSkill directoryの`config.yaml`も利用できるが、git管理外とする。

vault:
  # 対象Vault rootからの相対path。別Vaultを扱う場合だけ絶対pathへ変更する。
  root: "."

folders:
  inbox: "00-Inbox"
  projects: "01-Projects"
  areas: "02-Areas"
  resources: "03-Resources"
  archive: "04-Archive"
  daily: "05-Daily"
  templates: "06-Templates"
  sources: "07-Sources"
  # Vault内部に独立repositoryを置く場合の除外folder。
  local_repo: "LOCAL_REPO"

frontmatter:
  domain_field: "domain"        # 配列。ノートの技術テーマ分類
  review_cadence_field: "review_cadence"
  last_reviewed_field: "last_reviewed"

proposals:
  # 提案の出力先（Inboxフォルダからの相対パス、ファイル名は日付が自動付与される）
  output_filename_prefix: "reflect-proposals"
  # 全提案の処理結果を追記した後に移す、folders.archive配下の保存先
  archive_subfolder: "Reflect Proposals"

maintenance_heuristics:
  # 陳腐化候補と判定する閾値（Ars Contexta実装を参考にした初期値）
  stale_after_days: 30
  stale_max_incoming_links: 2
